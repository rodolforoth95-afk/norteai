# Copie para .env.local e preencha. Nunca envie .env.local para o Git.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor. Nunca use o prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Etapa 2). Só servidor.
ANTHROPIC_API_KEY=

# brapi.dev (cotações). Só servidor.
BRAPI_TOKEN=

# Login de demonstração "admin/admin" na versão publicada (para testes com colegas).
# Deixe desligado (0) quando o app for para clientes reais.
ADMIN_ATIVO=0
# Opcional: troque a senha de demonstração (padrão: admin)
# ADMIN_SENHA=

# WhatsApp (canal Baileys). Só servidor. Veja docs/whatsapp/README.md
# Chave compartilhada com o serviço do canal (gere com: openssl rand -hex 32)
WHATSAPP_CHAVE_INTERNA=
# Número do Findomo com DDI, só dígitos (ex.: 5511999998888), para o botão "Abrir o WhatsApp"
WHATSAPP_NUMERO=
# E-mails de quem opera o canal (vê o QR e pode desconectar), separados por vírgula
WHATSAPP_OPERADORES=
# Opcional: transcrição de áudio (OpenAI). Sem ela, o Mordomo pede para escrever.
OPENAI_API_KEY=
